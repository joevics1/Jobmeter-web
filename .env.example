# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key

# Admin Configuration
ADMIN_EMAIL_DOMAIN=@jobpilot.com

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron (protects /api/payment/reconcile from public calls — Vercel
# automatically sends this as a Bearer token when it triggers cron jobs,
# see vercel.json)
CRON_SECRET=your_key

UPSTASH_REDIS_REST_URL=your_key
UPSTASH_REDIS_REST_TOKEN=your_key

# Rate limiting on /jobs and /company (middleware.ts)
# MODE=shadow logs what would be blocked without actually blocking anyone —
# start here, watch the logs for a few days, then switch to "enforce".
RATE_LIMIT_MODE=shadow
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# Stricter limiter for job-submission endpoints (/api/jobs/submit,
# /api/jobs/parse-paste, /api/jobs/process-submission) — always enforced,
# not shadow mode, since these cost real Gemini API calls per request.
RATE_LIMIT_SUBMIT_MAX=8
RATE_LIMIT_SUBMIT_WINDOW_SECONDS=600

